table.insert(connections, RunService.Heartbeat:Connect(function()
    local elapsed = os.clock() - started
    borderGradient.Rotation = (elapsed * 60) % 360
    logo.Position = UDim2.new(0.5, 0, 0.5, math.sin(elapsed * 1.6) * 2.5)
    local pulse = (elapsed * 0.9) % 1
    liveHalo.Size = UDim2.fromOffset(8 + pulse * 10, 8 + pulse * 10)
    liveHalo.BackgroundTransparency = 0.45 + pulse * 0.55
    topLineGradient.Offset = Vector2.new(math.sin(elapsed * 0.8) * 0.25, 0)
    blobBlue.Position = UDim2.new(1, -20 + math.sin(elapsed * 0.6) * 16, 0, 6 + math.cos(elapsed * 0.5) * 12)
    blobRed.Position = UDim2.new(0, 16 + math.cos(elapsed * 0.55) * 14, 1, -4 + math.sin(elapsed * 0.7) * 10)
end))

task.spawn(function()
    task.wait(1.2)
    while not closed do
        shine.Position = UDim2.fromScale(-0.4, 0.5)
        tween(shine, quick(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.fromScale(1.4, 0.5) })
        task.wait(2.6)
    end
end)

