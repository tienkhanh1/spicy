local MONO = fontOf("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Medium, Enum.Font.RobotoMono)

local function create(className, properties, parent)
    local instance = Instance.new(className)
    instance.Name = randomName()
    for key, value in pairs(properties) do
        instance[key] = value
    end
    instance.Parent = parent
    return instance
end
local function round(parent, radius)
    return create("UICorner", { CornerRadius = radius }, parent)
end
local function sequence(points)
    local keypoints = {}
    for _, point in ipairs(points) do
        table.insert(keypoints, ColorSequenceKeypoint.new(point[1], point[2]))
    end
    return ColorSequence.new(keypoints)
end
local function fade(points)
    local keypoints = {}
    for _, point in ipairs(points) do
        table.insert(keypoints, NumberSequenceKeypoint.new(point[1], point[2]))
    end
    return NumberSequence.new(keypoints)
end
local function tween(instance, info, goal)
    local playing = TweenService:Create(instance, info, goal)
    playing:Play()
    return playing
end
local function quick(seconds, style, direction, delay)
    return TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out, 0, false, delay or 0)
end

