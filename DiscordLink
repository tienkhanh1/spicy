local function alreadyShown()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then
        return false
    end
    local okExists, exists = pcall(isfile, SAVE_FILE)
    if not okExists or not exists then
        return false
    end
    local okRead, content = pcall(readfile, SAVE_FILE)
    return okRead and type(content) == "string" and string.find(content, INVITE_URL, 1, true) ~= nil
end

local function markShown()
    if typeof(writefile) ~= "function" then
        return
    end
    pcall(function()
        if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SAVE_FOLDER) then
            makefolder(SAVE_FOLDER)
        end
        writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode({
            Shown = true,
            Invite = INVITE_URL,
            ShownAt = os.time(),
        }))
    end)
end

if alreadyShown() then
    environment[LOCK_KEY] = false
    return
end
