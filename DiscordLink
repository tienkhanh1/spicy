local function writeClipboard(text)
    local writer = (typeof(setclipboard) == "function" and setclipboard)
        or (typeof(toclipboard) == "function" and toclipboard)
        or (type(Clipboard) == "table" and typeof(Clipboard.set) == "function" and Clipboard.set)
        or nil
    if not writer then
        return false
    end
    return (pcall(writer, text))
end

