local random = Random.new()
local CHARACTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local function randomName()
    local length = random:NextInteger(10, 18)
    local parts = table.create(length)
    for index = 1, length do
        local pick = random:NextInteger(1, #CHARACTERS)
        parts[index] = string.sub(CHARACTERS, pick, pick)
    end
    return table.concat(parts)
end

local function resolveParent()
    if typeof(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then
            return result
        end
    end
    return CoreGui
end

local function fontOf(family, weight, fallback)
    local ok, font = pcall(Font.new, family, weight, Enum.FontStyle.Normal)
    if ok and font then
        return font
    end
    return Font.fromEnum(fallback)
end
local HEAVY = fontOf("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.Font.GothamBlack)
local BOLD = fontOf("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.Font.GothamBold)
