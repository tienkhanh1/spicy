local function refreshFit()
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
    if viewport.X < 1 or viewport.Y < 1 then
        viewport = Vector2.new(1280, 720)
    end
    local scale = math.min(viewport.X * 0.6 / DESIGN_WIDTH, viewport.Y * 0.5 / DESIGN_HEIGHT, 1.15)
    fitScale.Scale = math.max(scale, 0.5)
end

local function close(immediate)
    if closed then
        return
    end
    closed = true
    if environment[LOCK_KEY] == handle then
        environment[LOCK_KEY] = false
    end
    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(connections)
    if immediate then
        pcall(function()
            screenGui:Destroy()
        end)
        return
    end
    local out = quick(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(backdrop, out, { BackgroundTransparency = 1 })
    tween(popScale, out, { Scale = 0.9 })
    tween(card, out, { GroupTransparency = 1 })
    tween(borderStroke, out, { Transparency = 1 })
    for _, glow in ipairs(glows) do
        tween(glow, out, { BackgroundTransparency = 1 })
    end
    task.delay(0.3, function()
        pcall(function()
            screenGui:Destroy()
        end)
    end)
end
