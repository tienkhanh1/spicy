ApiImpl[26] = function(self, minimum)
    assertObject(self, "ExclusiveGroup")
    local parsed = tonumber(minimum)
    assert(parsed, "MinActive phai la mot so")
    self.MinActive = math.clamp(
        math.floor(parsed),
        0,
        self.MaxActive
    )
    self.AllowNone = self.MinActive == 0
    return self
