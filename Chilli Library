local CORE_URL = "https://raw.githubusercontent.com/tienkhanh1/spicy/refs/heads/main/ChilliLibraryCore"
local VERSION = "ChilliLibVersion3"
local FOLDER = "Chilli Hub"
local CACHE_FILE = FOLDER .. "/LibraryCore_" .. VERSION .. ".lua"
local function hasVersion(content)
    return type(content) == "string" and content ~= "" and string.find(content, VERSION, 1, true) ~= nil
end
local function readCache()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return nil
    end
    local okExists, exists = pcall(isfile, CACHE_FILE)
    if not okExists or not exists then
        return nil
    end
    local okRead, data = pcall(readfile, CACHE_FILE)
    return okRead and hasVersion(data) and data or nil
end
local function writeCache(data)
    if type(writefile) ~= "function" then
        return
    end
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(FOLDER) then
            makefolder(FOLDER)
        end
        writefile(CACHE_FILE, data)
    end)
end
local function build(source)
    local chunk = source and loadstring(source)
    if not chunk then
        return nil
    end
    local ok, factory = pcall(chunk)
    return ok and type(factory) == "function" and factory or nil
end
local source = readCache()
local factory = build(source)
if factory then
    task.spawn(function()
        local ok, fresh = pcall(game.HttpGet, game, CORE_URL)
        if ok and hasVersion(fresh) and fresh ~= source and loadstring(fresh) then
            writeCache(fresh)
        end
    end)
else
    source = game:HttpGet(CORE_URL)
    factory = build(source)
    assert(factory, "Chilli Library core is invalid.")
    if hasVersion(source) then
        writeCache(source)
    end
end
return factory
