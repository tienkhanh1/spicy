-- BE RONG DONG NOTE
-- Note dung TextScaled nen khung hep bao nhieu la chu nho bay nhieu. Truoc
-- day moi row deu ghim cung 0.66 nen row chi co mot cai nut hay can gat
-- (o dieu khien hep) bo phi mot mang trong ben phai va chu note bi thu nho
-- vo co.
-- Gio be rong duoc tinh TU MEP TRAI CUA CHINH O DIEU KHIEN cua row do:
--   nut / cong tac (o hep)      -> note keo dai gan het chieu ngang
--   dropdown / input / slider   -> note tu ngan lai vua du, khong de len o
-- Row khong co o dieu khien (Text, Label) thi dung tron NOTE_MAX_WIDTH.
local NOTE_LEFT = 0.025
local NOTE_GAP = 0.02
local NOTE_MAX_WIDTH = 0.94
local NOTE_MIN_WIDTH = 0.3

local function noteWidthFor(control)
    if not control then
        return NOTE_MAX_WIDTH
    end

    local controlLeft = control.Position.X.Scale
        - control.Size.X.Scale * control.AnchorPoint.X

    return math.clamp(
        controlLeft - NOTE_LEFT - NOTE_GAP,
        NOTE_MIN_WIDTH,
        NOTE_MAX_WIDTH
    )
end

