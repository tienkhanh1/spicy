    return ApiImpl[5](self, target, function(value, currentTarget, source, targetState)
        if predicate(value, currentTarget, source, targetState) then
            if type(targetValue) == "function" then
                return targetValue(
                    value,
                    currentTarget,
                    source,
                    targetState
