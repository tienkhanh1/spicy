    caption.BorderSizePixel = 0
    caption.Position = UDim2.fromScale(0.5, 0.5)
    caption.Size = UDim2.fromScale(0.9, 0.62)
    caption.Text = currentButtonText
    caption.TextWrapped = true
    caption.ZIndex = 6
