    applyShinyTextStyle(caption, normalTextFont)

    -- Preview: chi doi chu 1 nhip roi tra ve, khong dung toi du lieu game.
    local busy = false
    -- Tach rieng phan HINH ANH cua mot lan bam de keybind goi lai duoc:
    -- nhun nut + doi chu xac nhan, y het luc bam chuot.
    local function playPress()
        local scale = button:FindFirstChildOfClass("UIScale")
        if scale then
            TweenService:Create(
                scale,
                TweenInfo.new(
                    0.055,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out
                ),
                { Scale = 0.96 }
            ):Play()
            task.delay(0.07, function()
                if scale.Parent then
                    TweenService:Create(
                        scale,
                        TweenInfo.new(
                            0.09,
                            Enum.EasingStyle.Quad,
                            Enum.EasingDirection.Out
                        ),
                        { Scale = 1 }
                    ):Play()
                end
            end)
        end
        if busy or currentConfirmText == "" then
            return
        end
        busy = true
        caption.Text = currentConfirmText
        task.delay(0.9, function()
            caption.Text = currentButtonText
            busy = false
        end)
    end

    connectSafeActivation(button, playPress)

    return row, playPress
end

